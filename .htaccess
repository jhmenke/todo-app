Options -Indexes

# Redirect bare directory to index.php
DirectoryIndex index.php

# Protect sensitive files from direct access
<FilesMatch "^(config.*|cron)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(db|db-wal|db-shm|log)$">
    Require all denied
</FilesMatch>

# PHP upload limits (ignored under PHP-FPM; set these in php.ini / pool config instead)
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
</IfModule>
